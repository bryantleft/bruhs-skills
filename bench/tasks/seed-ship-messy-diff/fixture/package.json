{
  "name": "tally",
  "version": "1.2.0",
  "description": "Summarize time-tracking logs from the command line",
  "private": true,
  "type": "module",
  "bin": {
    "tally": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tally": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
